+std::vector<uint8> CGSH_OpenGL::ReadPopulationForValidation(uint32 psm, bool dirty)
+{
+ auto fb=std::make_shared<CFramebuffer>(0,64,1024,psm,1,false);
+ PopulateFramebuffer(fb);
+ if(dirty){
+  for(uint32 i=0;i<4*1024*1024;i++) m_pRAM[i]^=255;
+  fb->m_cachedArea.Invalidate(0,4*1024*1024);
+  CommitFramebufferDirtyPages(fb,0,1024);
+ }
+ std::vector<uint8> result(64*1024*4);
+ glBindFramebuffer(GL_FRAMEBUFFER,fb->m_framebuffer);
+ glReadPixels(0,0,64,1024,GL_RGBA,GL_UNSIGNED_BYTE,result.data());
+ return result;
+}
+
+void CGSH_OpenGL::SeedReadbackForValidation(uint32 psm)
+{
+ FlushVertexBuffer();m_renderState.isValid=false;m_validGlState=0;
+ m_framebuffers.clear();
+ auto fb=std::make_shared<CFramebuffer>(0,128,512,psm,m_fbScale,false);
+ PopulateFramebuffer(fb);fb->m_cachedArea.ClearDirtyPages();
+ m_framebuffers.push_back(fb);
+}
+
+std::vector<uint8> CGSH_OpenGL::ReadCachedForValidation(uint32 psm)
+{
+ FlushVertexBuffer();
+ auto it=std::find_if(m_framebuffers.begin(),m_framebuffers.end(),[&](const FramebufferPtr& fb){return fb->m_basePtr==0 && fb->m_psm==psm && fb->m_width==128;});
+ FramebufferPtr fb;
+ if(it==m_framebuffers.end()){
+  fb=std::make_shared<CFramebuffer>(0,128,512,psm,m_fbScale,false);
+  PopulateFramebuffer(fb);fb->m_cachedArea.ClearDirtyPages();m_framebuffers.push_back(fb);
+ }else fb=*it;
+ std::vector<uint8> result(128*512*4);
+ glBindFramebuffer(GL_FRAMEBUFFER,fb->m_framebuffer);
+ glReadPixels(0,0,128,512,GL_RGBA,GL_UNSIGNED_BYTE,result.data());
+ m_renderState.isValid=false;m_validGlState=0;
+ return result;
+}
+
+// CPU memory has been replaced by a restored state. Discard every GPU cache
+// and pending primitive without flushing old work into the newly loaded RAM.
+// Register/VRAM/CLUT state is owned by CGSHandler/the runtime adapter.
+void CGSH_OpenGL::WriteBackMemoryCache()
+{
+ ResetImpl();
+}

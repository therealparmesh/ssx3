+// GPU-owned surface export. General overlapping-view reconciliation remains
+// unsupported: reject ambiguous ownership before changing the CPU RAM image.
+void CGSH_OpenGL::MarkGpuWrites()
+{
+	if(m_vertexBuffer.empty()) return;
+	auto frame = make_convertible<FRAME>(m_renderState.frameReg);
+	auto zbuf = make_convertible<ZBUF>(m_renderState.zbufReg);
+	auto fb = FindFramebuffer(frame);
+	auto depth = FindDepthbuffer(zbuf, frame);
+	if(!fb) return;
+	float minX = m_vertexBuffer.front().x, maxX = minX, minY = m_vertexBuffer.front().y, maxY = minY;
+	for(const auto& v : m_vertexBuffer)
+	{
+		minX = std::min(minX, v.x);
+		maxX = std::max(maxX, v.x);
+		minY = std::min(minY, v.y);
+		maxY = std::max(maxY, v.y);
+	}
+	int x0 = std::max({0, m_renderState.scissorX, int(std::floor(minX)) - 2});
+	int y0 = std::max({0, m_renderState.scissorY, int(std::floor(minY)) - 2});
+	int x1 = std::min({int(fb->m_width), m_renderState.scissorX + m_renderState.scissorWidth, int(std::ceil(maxX)) + 2});
+	int y1 = std::min({int(fb->m_height), m_renderState.scissorY + m_renderState.scissorHeight, int(std::ceil(maxY)) + 2});
+	if(frame.nMask != 0xffffffffu) fb->m_gpuDirty.include(x0, y0, x1, y1);
+	if(depth && (m_renderState.testReg & (1ull << 16)) && ((m_renderState.testReg >> 17) & 3) != 0 && !zbuf.nMask)
+		depth->m_gpuDirty.include(x0, y0, x1, y1);
+}

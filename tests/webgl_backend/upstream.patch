+			}
+			else if(depth->m_psm == 2)
+			{
+				CGsPixelFormats::CPixelIndexor<CGsPixelFormats::STORAGEPSMZ16> i(m_pRAM, depth->m_basePtr, depth->m_width / 64);
+				claim(i, depth->m_gpuDirty, 2);
+			}
+			else if(depth->m_psm == 10)
+			{

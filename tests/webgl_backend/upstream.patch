+bool CGSH_OpenGL::PrimitiveOverlapsPending()const
+{
+ if(m_vertexBuffer.empty())return false;
+ // A conservative pixel bounding box proves destination/depth independence.
+ // Keep lines and points serialized, including their rasterization margins.

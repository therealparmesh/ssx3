+		for(int y = rect.y0; y < rect.y1; y++)
+			for(int x = rect.x0; x < rect.x1; x++)
+			{
+				auto address = reinterpret_cast<uint8*>(indexor.GetPixelAddress(x, y)) - m_pRAM;
+				for(unsigned b = 0; b < bytes; b++)

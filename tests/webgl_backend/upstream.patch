+void CGSH_OpenGL::BeginTransferWrite()
+{
+	// Uploading a different physical page cannot overwrite GPU-owned bytes.
+	// Check pages, rather than just the transfer's pixels, because the native
+	// framebuffer cache refreshes complete pages after a partial CPU upload.
+	FlushVertexBuffer();
+	if(m_memoryAliasUnresolved) SyncMemoryCache();
+	auto buffer = make_convertible<BITBLTBUF>(m_nReg[GS_REG_BITBLTBUF]);
+	auto pos = make_convertible<TRXPOS>(m_nReg[GS_REG_TRXPOS]);
+	auto rect = make_convertible<TRXREG>(m_nReg[GS_REG_TRXREG]);
+	if(rect.nRRW && rect.nRRH)
+	{
+		std::array<bool, RAMSIZE / 8192> dirty{};
+		auto mark = [&](uint32 base, uint32 width, uint32 psm, const DirtyRect& r) {
+			if(r.empty()) return;
+			auto page = CGsPixelFormats::GetPsmPageSize(psm);
+			for(int py = r.y0 / page.second; py <= (r.y1 - 1) / page.second; py++)
+				for(int px = r.x0 / page.first; px <= (r.x1 - 1) / page.first; px++)
+					dirty[((base / 8192) + py * (width / page.first) + px) % (RAMSIZE / 8192)] = true;
+		};
+		for(const auto& fb : m_framebuffers)
+			mark(fb->m_basePtr, fb->m_width, fb->m_psm, fb->m_gpuDirty);
+		for(const auto& depth : m_depthbuffers)
+			mark(depth->m_basePtr, depth->m_width, 0x30 | depth->m_psm, depth->m_gpuDirty);
+		bool overlap = false;
+		if(!buffer.GetDstWidth() || pos.nDSAX + rect.nRRW > buffer.GetDstWidth() || pos.nDSAY + rect.nRRH > 2048)
+		{
+			overlap = std::any_of(dirty.begin(), dirty.end(), [](bool value) { return value; });
+		}
+		else
+		{
+			auto range = GsTransfer::GetDstRange(buffer, rect, pos);
+			if(range.second >= RAMSIZE)
+				overlap = std::any_of(dirty.begin(), dirty.end(), [](bool value) { return value; });
+			else
+				for(uint32 page = range.first / 8192; page <= (range.first + range.second - 1) / 8192; page++)
+					overlap |= dirty[page % (RAMSIZE / 8192)];
+		}
+		if(overlap) SyncMemoryCache();
+	}
+	CGSHandler::BeginTransferWrite();
+}

+#include "GSH_OpenGL_MemorySync.inc"
+
+void CGSH_OpenGL::SeedDepthExportForValidation(uint32 psm)
+{
+ auto depth=std::make_shared<CDepthbuffer>(2<<20,128,512,psm,1,false);
+ PopulateDepthbuffer(depth);depth->m_gpuDirty.include(0,0,128,512);
+ m_depthbuffers.push_back(depth);
+}
+
+bool CGSH_OpenGL::HasCachedCopySurface(uint32 base,uint32 width,uint32 psm)const
+{
+ return std::any_of(m_framebuffers.begin(),m_framebuffers.end(),[&](const FramebufferPtr& fb){return fb->m_basePtr==base&&fb->m_width==width&&fb->m_psm==psm;});
+}

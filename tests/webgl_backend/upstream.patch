+			if(fb->m_psm == PSMCT32 || fb->m_psm == PSMCT24)
+			{
+				CGsPixelFormats::CPixelIndexorPSMCT32 i(m_pRAM, fb->m_basePtr, fb->m_width / 64);
+				claim(i, fb->m_gpuDirty, fb->m_psm == PSMCT24 ? 3 : 4);
+			}
+			else if(fb->m_psm == PSMCT16)
+			{
+				CGsPixelFormats::CPixelIndexorPSMCT16 i(m_pRAM, fb->m_basePtr, fb->m_width / 64);
+				claim(i, fb->m_gpuDirty, 2);
+			}
+			else if(fb->m_psm == PSMCT16S)
+			{

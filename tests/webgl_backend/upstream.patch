+					uint64 bit = uint64(1) << (byte & 63);
+					if(owner[byte >> 6] & bit) throw std::runtime_error("GPU memory export requires physical alias reconciliation");
+					owner[byte >> 6] |= bit;
+				}
+			}
+	};

+			CGsPixelFormats::CPixelIndexorPSMCT16 i16(staged.data(), fb->m_basePtr, fb->m_width / 64);
+			CGsPixelFormats::CPixelIndexorPSMCT16S i16s(staged.data(), fb->m_basePtr, fb->m_width / 64);

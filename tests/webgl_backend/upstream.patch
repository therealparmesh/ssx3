+void CGSH_OpenGL::SyncMemoryCache()
+{
+	FlushVertexBuffer();
+	if(m_memoryAliasUnresolved) throw std::runtime_error("GPU memory export requires physical alias reconciliation");
+	bool dirty = false;
+	for(const auto& fb : m_framebuffers)
+		dirty |= !fb->m_gpuDirty.empty();

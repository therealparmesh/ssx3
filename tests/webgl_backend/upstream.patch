+   }
+   if(!sharedEdgeOnly && n==3 && at+3<=m_vertexBuffer.size()){
+    // Convex triangle interiors are disjoint if either triangle has an edge
+    // normal with disjoint projected intervals. Retain a conservative 1/8px
+    // L1 margin so subpixel rasterization cannot create a shared sample.
+    double pending[3][2];for(unsigned j=0;j<3;j++){pending[j][0]=m_vertexBuffer[at+j].x;pending[j][1]=m_vertexBuffer[at+j].y;}
